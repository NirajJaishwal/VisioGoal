# Copy to `.env` and fill in real values. `.env` is git-ignored — never commit secrets.

# --- PostgreSQL (used by docker-compose to provision the database) ---
POSTGRES_USER=football
POSTGRES_PASSWORD=changeme
POSTGRES_DB=football_intel

# --- Async SQLAlchemy connection URL ---
# Local run:            host = localhost
# Inside docker-compose: host = postgres  (the service name)
DATABASE_URL=postgresql+asyncpg://football:changeme@localhost:5432/football_intel

# --- Football-Data.org API (free tier) ---
# Get a free key at https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=
FOOTBALL_DATA_BASE_URL=https://api.football-data.org/v4
# Comma-separated competition codes (top-5 leagues on the free tier):
#   PL=Premier League · PD=La Liga · BL1=Bundesliga · SA=Serie A · FL1=Ligue 1
FOOTBALL_DATA_COMPETITIONS=["PL","PD","BL1","SA","FL1"]
# Season to ingest, as the starting year (e.g. 2025 = the 2025/26 season).
# Leave blank to fetch each competition's CURRENT season — but note that before a
# season kicks off, no matches are played yet, so all scores are null. Pin a
# completed/in-progress season to ingest real match results.
FOOTBALL_DATA_SEASON=2025

# --- Groq (LLM provider for the AI copilot) ---
# Get a free key at https://console.groq.com/keys  (keys start with `gsk_`).
# Server-side only — the frontend never sees it; all AI calls proxy through FastAPI.
GROQ_API_KEY=
# Model id — see https://console.groq.com/docs/models for the current catalog.
GROQ_MODEL=llama-3.3-70b-versatile
# Max tokens for one streamed answer.
CHAT_MAX_TOKENS=2048

# --- ChromaDB (vector store; compose service name + INTERNAL port) ---
# Host port is 8001, but inside the compose network it listens on 8000.
CHROMA_HOST=chromadb
CHROMA_PORT=8000
CHROMA_COLLECTION=football_docs

# --- Embeddings (local Sentence Transformers model, no external API) ---
# Must be identical for backend and ingestion, or similarity search is meaningless.
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Frontend → backend ---
# Leave unset in docker-compose: the Next server proxies /api/* to the backend.
# API_PROXY_TARGET=http://backend:8000
